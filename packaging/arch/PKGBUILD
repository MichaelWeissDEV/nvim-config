# Package-local recipe. Stage checksummed sources with packaging/arch/build.sh.
pkgname=arch-dotfiles-nvim
pkgver=0.3.0
pkgrel=1
pkgdesc='Neovim configuration with vendored plugins'
arch=('any')
url='https://github.com/MichaelWeissDEV/dotfiles'
license=('LicenseRef-arch-dotfiles-bundle')
depends=('arch-dotfiles-core>=0.3.0' 'neovim>=0.12.0' 'git' 'ripgrep' 'fd' 'fzf' 'curl' 'tar' 'gzip' 'unzip')
optdepends=('base-devel: compile optional parsers' 'nodejs: optional language tools' 'npm: optional Mason tools' 'python-pip: optional Python tools')
options=('!strip')
source=('payload.tar.gz')
sha256sums=('__SOURCE_SHA256__')

package() {
    cp -a "$srcdir/usr" "$pkgdir/"
}
